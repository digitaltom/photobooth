[Unit]
Description=Photobox rails app (web and jobs)
After=network.target

[Service]
User=photobox
WorkingDirectory=/var/lib/photobox/current
Environment=RAILS_ENV=production
# Ruby of the release (bin/build-image)
Environment=PATH=/var/lib/photobox/current/vendor/ruby/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# SECRET_KEY_BASE and PHOTOBOX_STORAGE, written by photobox-firstboot
EnvironmentFile=-/var/lib/photobox/photobox.env
ExecStart=/var/lib/photobox/current/bin/rails server
Restart=on-failure

[Install]
WantedBy=multi-user.target
