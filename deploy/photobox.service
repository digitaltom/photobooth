[Unit]
Description=Photobox rails app (web and jobs)
After=network.target

[Service]
User=photobox
WorkingDirectory=/opt/photobox
Environment=RAILS_ENV=production
Environment=RAILS_LOG_TO_STDOUT=true
# Ruby of the release (bin/build-image)
Environment=PATH=/opt/photobox/vendor/ruby/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# SECRET_KEY_BASE and PHOTOBOX_STORAGE, written by photobox-firstboot
EnvironmentFile=-/var/lib/photobox/photobox.env
ExecStart=/opt/photobox/bin/rails server
Restart=on-failure

[Install]
WantedBy=multi-user.target
