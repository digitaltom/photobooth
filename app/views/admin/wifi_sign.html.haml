.wifi-sign.text-center
  %h1 Photobox
  %p.lead= _('Scan to join the WLAN and see your pictures')
  .wifi-qr= wifi_qr_svg
  %p
    = _('WLAN:')
    %b= wifi_ssid
  - if wifi_password
    %p
      = _('Password:')
      %b= wifi_password
  %p= ApplicationHelper::PHOTOBOX_URL
  .no-print
    %button.btn.btn-primary{ onclick: 'window.print()' }= _('Print')
    = link_to _('Back'), admin_path, class: 'btn btn-light'
