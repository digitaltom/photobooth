-# dark Bootstrap colors for the cards, tables and form fields
.container.admin{ data: { bs_theme: 'dark' } }
  .admin-header
    %h1.gallery-title Admin
    = link_to root_path, class: 'btn gallery-btn' do
      = icon('grid')
      Gallery
    = button_to 'Logout', admin_logout_path, method: :delete, class: 'btn gallery-btn'

  .card.mb-3
    .card-header Galleries
    .card-body
      %p
        Storage
        %code= @disk[:path]
        (#{@disk[:source]})
      - used = (100.0 * @disk[:used] / @disk[:size]).round
      .progress.disk-bar{ role: 'progressbar', aria: { valuenow: used, valuemin: 0, valuemax: 100 } }
        .progress-bar{ class: ('bg-danger' if used > 90), style: "width: #{used}%" }
          #{number_to_human_size(@disk[:used])} used (#{used}%)
        .disk-free #{number_to_human_size(@disk[:avail])} free (#{(100.0 * @disk[:avail] / @disk[:size]).round}%)
      %table.table
        %tr
          %th Gallery
          %th Sets
          %th Size
          %th
        - @galleries.each do |gallery|
          %tr{ class: ('table-success' if gallery == @gallery) }
            %td
              = gallery.caption
              %small.text-muted= l(gallery.created_at.to_date)
            %td= gallery.sets_count
            %td= number_to_human_size(gallery.size)
            %td
              .d-flex.gap-1.justify-content-end
                %button.btn.btn-light.btn-sm{ type: 'button', title: 'Rename', aria: { label: 'Rename' },
                  popovertarget: "caption-#{gallery.name}" }= icon('pencil')
                -# native popover: no Bootstrap JS on this page
                .admin-popover{ id: "caption-#{gallery.name}", popover: '' }
                  = form_with url: admin_gallery_caption_path(gallery), method: :patch, data: { controller: 'caption-preview' } do |f|
                    .polaroid-preview
                      .polaroid-photo
                      .polaroid-caption{ data: { caption_preview_target: 'output' } }= gallery.caption
                    .d-flex.flex-wrap.gap-2
                      = f.text_field :caption, value: gallery.caption, class: 'form-control',
                        data: { caption_preview_target: 'input', action: 'caption-preview#update' }
                      = f.submit 'Save caption', class: 'btn btn-primary'
                    %p.form-text
                      The caption is the title of the gallery and is printed on the new pictures.
                      Pictures that you already took keep their caption.
                = link_to download_gallery_path(gallery), class: 'btn btn-light btn-sm', title: 'Download',
                  aria: { label: 'Download' }, data: { turbo: false }, download: true do
                  = icon('download')
                -# like a radio button: the active gallery is checked
                - if gallery == @gallery
                  %span.admin-active{ title: 'Active', aria: { label: 'Active' } }= icon('check-circle')
                - else
                  = button_to admin_activate_gallery_path(gallery), method: :patch, class: 'btn btn-light btn-sm',
                    title: 'Activate', aria: { label: 'Activate' } do
                    = icon('circle')
                - unless gallery == @gallery
                  = button_to admin_destroy_gallery_path(gallery), method: :delete, class: 'btn btn-danger btn-sm',
                    title: 'Delete', aria: { label: 'Delete' },
                    form: { data: { turbo_confirm: "Delete the gallery #{gallery.caption} with #{gallery.sets_count} sets?" } } do
                    = icon('trash')
      = form_with url: admin_galleries_path, class: 'd-flex flex-wrap gap-2' do |f|
        = f.text_field :caption, required: true, class: 'form-control',
          placeholder: 'Caption of the new event'
        = f.submit 'Start new gallery', class: 'btn btn-success'

  .card.mb-3
    .card-header
      Network
      %small.text-muted
        - if @hotspot
          SSID #{wifi_ssid} · #{wifi_password ? "password #{wifi_password}" : 'open'} · IP #{@wlan_ip}
        - else
          Hotspot is not running
        - if @eth_ip
          · Ethernet #{@eth_ip}
    .card-body
      - if @hotspot
        %table.table
          %tr
            %th Name
            %th IP
            %th MAC
            %th State
          - @devices.each do |device|
            %tr
              %td= device[:name]
              %td= device[:ip]
              %td
                %code= device[:mac]
              %td= device[:state]
      = link_to admin_wifi_sign_path, class: 'btn btn-light' do
        = icon('qr')
        Printable WLAN sign

  .card.mb-3
    .card-header Camera
    .card-body
      %pre.small= @camera[:summary]
      - if @camera[:current_imageformat]
        %p
          Image format on the camera:
          %b= @camera[:current_imageformat]
      -# only the choices of the camera, without a camera none
      - formats = ['', *@camera[:imageformats]]
      - choices = formats.map { |format| [format.empty? ? 'Keep the setting of the camera' : [format, Camera::IMAGEFORMATS[format]].compact.join(': '), format] }
      = form_with url: admin_imageformat_path, method: :patch, class: 'd-flex flex-wrap gap-2' do |f|
        = f.select :imageformat, choices, { selected: OPTS.camera_imageformat.to_s }, class: 'form-select w-auto'
        = f.submit 'Set image format', class: 'btn btn-primary'
      %p.form-text Smaller images are faster to download and print.

  .card.mb-3
    .card-header System
    .card-body
      %p
        Version:
        %b= @version || 'development'
        - if @revision
          %code= @revision
      - if @updatable
        = form_with url: admin_update_path, multipart: true, class: 'd-flex flex-wrap gap-2 mb-3',
          data: { turbo_confirm: 'Install this app release and restart the app?' } do |f|
          = f.file_field :app, accept: '.zst', required: true, class: 'form-control w-auto'
          = f.submit 'Update app', class: 'btn btn-warning'
      = form_with url: admin_time_path, method: :patch, class: 'd-flex flex-wrap align-items-center gap-2',
        data: { controller: 'device-time' } do |f|
        %span
          Time on the Photobox:
          %b= l(Time.now.getlocal, format: :long)
        = f.hidden_field :time, data: { device_time_target: 'input' }
        %button.btn.btn-primary{ type: 'button', data: { action: 'device-time#use' } }
          Set to
          %span{ data: { device_time_target: 'label' } } the time of this device
      .d-flex.flex-wrap.gap-2.mt-3{ data: { controller: 'modal' } }
        %button.btn.btn-warning{ type: 'button', data: { action: 'modal#open' } } Change admin password
        -# no padding on the dialog: a tap on it counts as a tap on the backdrop
        %dialog.admin-popover.p-0{ data: { modal_target: 'dialog', action: 'click->modal#closeOnBackdrop' } }
          = form_with url: admin_password_path, method: :patch, class: 'd-grid gap-2 p-4' do |f|
            = f.password_field :old_password, placeholder: 'Old password', required: true, class: 'form-control'
            = f.password_field :new_password, placeholder: 'New password', required: true, minlength: 8, class: 'form-control'
            = f.password_field :password_repeat, placeholder: 'Repeat new password', required: true, class: 'form-control'
            = f.submit 'Change password', class: 'btn btn-primary'
        = button_to 'Restart', admin_restart_path, class: 'btn btn-warning',
          form: { data: { turbo_confirm: 'Restart the Photobox?' } }
