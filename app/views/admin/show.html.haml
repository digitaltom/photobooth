-# dark Bootstrap colors for the cards, tables and form fields
.container.admin{ data: { bs_theme: 'dark' } }
  .admin-header
    %h1.gallery-title Admin
    = link_to root_path, class: 'btn gallery-btn' do
      = icon('grid')
      Gallery
    = button_to 'Logout', admin_logout_path, method: :delete, class: 'btn btn-danger'

  .card.mb-3
    .card-header Gallery
    .card-body
      %p
        Data partition: #{number_to_human_size(@disk[:used])} used, #{number_to_human_size(@disk[:avail])} free
      %meter.disk-meter{ min: 0, max: @disk[:size], value: @disk[:used], high: (@disk[:size] * 0.9).to_i }
      %table.table
        %tr
          %th Gallery
          %th Sets
          %th Size
          %th
          %th
        - @galleries.each do |gallery|
          %tr
            %td
              = gallery.caption
              %small.text-muted= gallery.name
            %td= gallery.sets_count
            %td= number_to_human_size(gallery.size)
            %td
              = link_to download_gallery_path(gallery), class: 'btn btn-light btn-sm', title: 'Download',
                aria: { label: 'Download' }, data: { turbo: false }, download: true do
                = icon('download')
            %td
              -# like a radio button: the active gallery is checked
              - if gallery == @gallery
                %span.admin-active{ title: 'Active', aria: { label: 'Active' } }= icon('check-circle')
              - else
                = button_to admin_activate_gallery_path(gallery), method: :patch, class: 'btn btn-light btn-sm',
                  title: 'Activate', aria: { label: 'Activate' } do
                  = icon('circle')
      = form_with url: admin_galleries_path, class: 'd-flex flex-wrap gap-2' do |f|
        = f.text_field :caption, maxlength: Gallery::CAPTION_MAX_LENGTH, required: true, class: 'form-control',
          placeholder: 'Caption of the new event'
        = f.submit 'Start new gallery', class: 'btn btn-primary'

  .card.mb-3
    .card-header Caption of the active gallery
    .card-body
      = form_with url: admin_caption_path, method: :patch, data: { controller: 'caption-preview' } do |f|
        .polaroid-preview
          .polaroid-photo
          .polaroid-caption{ data: { caption_preview_target: 'output' } }= @gallery.caption
        .d-flex.flex-wrap.gap-2
          = f.text_field :caption, value: @gallery.caption, maxlength: Gallery::CAPTION_MAX_LENGTH, class: 'form-control',
            data: { caption_preview_target: 'input', action: 'caption-preview#update' }
          = f.submit 'Save caption', class: 'btn btn-primary'
        %p.form-text
          Max. #{Gallery::CAPTION_MAX_LENGTH} characters, applies to new sets.

  .card.mb-3
    .card-header Network
    .card-body
      %table.table
        %tr
          %th Name
          %th IP
          %th MAC
          %th State
        - @devices.each do |device|
          %tr
            %td= device[:name]
            %td= device[:ip]
            %td
              %code= device[:mac]
            %td= device[:state]
      = link_to 'Printable WLAN sign', admin_wifi_sign_path, class: 'btn btn-light'

  .card.mb-3
    .card-header Time
    .card-body
      %p
        Time on the Photobox:
        %b= l(Time.now.getlocal, format: :long)
      = form_with url: admin_time_path, method: :patch, class: 'd-flex flex-wrap gap-2', data: { controller: 'device-time' } do |f|
        %button.btn.btn-primary{ type: 'button', data: { action: 'device-time#use' } } Use the time of this device
        = f.datetime_local_field :time, step: 1, required: true, class: 'form-control', data: { device_time_target: 'input' }
        = f.submit 'Set time', class: 'btn btn-light'

  .card.mb-3
    .card-header Admin password
    .card-body
      = form_with url: admin_password_path, method: :patch do |f|
        = f.password_field :old_password, placeholder: 'Old password', required: true, class: 'form-control'
        = f.password_field :new_password, placeholder: 'New password', required: true, minlength: 8, class: 'form-control'
        = f.password_field :password_repeat, placeholder: 'Repeat new password', required: true, class: 'form-control'
        = f.submit 'Change password', class: 'btn btn-primary'

  .card.mb-3
    .card-header System
    .card-body
      = button_to 'Restart', admin_power_path(command: 'reboot'), class: 'btn btn-warning',
        form_class: 'inline-form', form: { data: { turbo_confirm: 'Restart the Photobox?' } }
      = button_to 'Shut down', admin_power_path(command: 'poweroff'), class: 'btn btn-danger',
        form_class: 'inline-form', form: { data: { turbo_confirm: 'Shut down the Photobox?' } }
