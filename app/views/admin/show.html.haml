-# dark Bootstrap colors for the cards, tables and form fields
.container.admin{ data: { bs_theme: 'dark' } }
  .admin-header
    %h1.gallery-title= _('Admin')
    = link_to root_path, class: 'btn gallery-btn' do
      = icon('grid')
      = _('Gallery')
    = button_to _('Logout'), admin_logout_path, method: :delete, class: 'btn gallery-btn'

  .card.mb-3
    .card-header= _('Galleries')
    .card-body
      %p
        = _('Storage')
        %code= @disk[:path]
        (#{@disk[:source]})
      - used = (100.0 * @disk[:used] / @disk[:size]).round
      .progress.disk-bar{ role: 'progressbar', aria: { valuenow: used, valuemin: 0, valuemax: 100 } }
        .progress-bar{ class: ('bg-danger' if used > 90), style: "width: #{used}%" }
          #{_('%{size} used') % { size: number_to_human_size(@disk[:used]) }} (#{used}%)
        .disk-free #{_('%{size} free') % { size: number_to_human_size(@disk[:avail]) }} (#{(100.0 * @disk[:avail] / @disk[:size]).round}%)
      %table.table
        %tr
          %th= _('Gallery')
          %th= _('Sets')
          %th= _('Size')
          %th
        - @galleries.each do |gallery|
          %tr{ class: ('table-success' if gallery == @gallery) }
            %td
              = gallery.caption
              %small.text-muted= l(gallery.created_at.to_date)
            %td= gallery.sets_count
            %td= number_to_human_size(gallery.size)
            %td
              .d-flex.gap-1.justify-content-end
                %button.btn.btn-light.btn-sm{ type: 'button', title: _('Rename'), aria: { label: _('Rename') },
                  popovertarget: "caption-#{gallery.name}" }= icon('pencil')
                -# native popover: no Bootstrap JS on this page
                .admin-popover{ id: "caption-#{gallery.name}", popover: '' }
                  = form_with url: admin_gallery_caption_path(gallery), method: :patch, data: { controller: 'caption-preview' } do |f|
                    .polaroid-preview
                      .polaroid-photo
                      .polaroid-caption{ data: { caption_preview_target: 'output' } }= gallery.caption
                    .d-flex.flex-wrap.gap-2
                      = f.text_field :caption, value: gallery.caption, class: 'form-control',
                        data: { caption_preview_target: 'input', action: 'caption-preview#update' }
                      = f.submit _('Save caption'), class: 'btn btn-primary'
                    %p.form-text
                      = _('The caption is the title of the gallery and is printed on the new pictures.')
                      = _('Pictures that you already took keep their caption.')
                = link_to download_gallery_path(gallery), class: 'btn btn-light btn-sm', title: _('Download'),
                  aria: { label: _('Download') }, data: { turbo: false }, download: true do
                  = icon('download')
                -# like a radio button: the active gallery is checked
                - if gallery == @gallery
                  %span.admin-active{ title: _('Active'), aria: { label: _('Active') } }= icon('check-circle')
                - else
                  = button_to admin_activate_gallery_path(gallery), method: :patch, class: 'btn btn-light btn-sm',
                    title: _('Activate'), aria: { label: _('Activate') } do
                    = icon('circle')
                - unless gallery == @gallery
                  - confirm = _('Delete the gallery %{caption} with %{count} sets?') % { caption: gallery.caption, count: gallery.sets_count }
                  = button_to admin_destroy_gallery_path(gallery), method: :delete, class: 'btn btn-danger btn-sm',
                    title: _('Delete'), aria: { label: _('Delete') }, form: { data: { turbo_confirm: confirm } } do
                    = icon('trash')
      = form_with url: admin_galleries_path, class: 'd-flex flex-wrap gap-2' do |f|
        = f.text_field :caption, required: true, class: 'form-control',
          placeholder: _('Caption of the new event')
        = f.submit _('Start new gallery'), class: 'btn btn-success'

  .card.mb-3
    .card-header
      = _('Network')
      %small.text-muted
        - if @hotspot
          SSID #{wifi_ssid} · #{wifi_password ? _('password %{password}') % { password: wifi_password } : _('open')} · IP #{@wlan_ip}
        - else
          = _('Hotspot is not running')
        - if @eth_ip
          · Ethernet #{@eth_ip}
    .card-body
      - if @hotspot
        %table.table
          %tr
            %th= _('Name')
            %th IP
            %th MAC
            %th= _('State')
          - @devices.each do |device|
            %tr
              %td= device[:name]
              %td= device[:ip]
              %td
                %code= device[:mac]
              %td= device[:state]
      = link_to admin_wifi_sign_path, class: 'btn btn-light' do
        = icon('qr')
        = _('Printable WLAN flyer')

  .card.mb-3
    .card-header= _('Camera')
    .card-body
      %pre.small= @camera[:summary]
      - if @camera[:current_imageformat]
        %p
          = _('Image format on the camera:')
          %b= @camera[:current_imageformat]
      -# only the choices of the camera, without a camera none
      - formats = ['', *@camera[:imageformats]]
      - choices = formats.map { |format| [format.empty? ? _('Keep the setting of the camera') : [format, Camera::IMAGEFORMATS[format]].compact.join(': '), format] }
      = form_with url: admin_imageformat_path, method: :patch, class: 'd-flex flex-wrap gap-2' do |f|
        = f.select :imageformat, choices, { selected: OPTS.camera_imageformat.to_s }, class: 'form-select w-auto'
        = f.submit _('Set image format'), class: 'btn btn-primary'
      %p.form-text= _('Smaller images are faster to download and print.')

  .card.mb-3
    .card-header= _('System')
    .card-body
      %p
        = _('Version:')
        %b= @version || _('development')
        - if @revision
          %code= @revision
      - if @updatable
        = form_with url: admin_update_path, multipart: true, class: 'd-flex flex-wrap gap-2 mb-3',
          data: { turbo_confirm: _('Install this app release and restart the app?') } do |f|
          = f.file_field :app, accept: '.zst', required: true, class: 'form-control w-auto'
          = f.submit _('Update app'), class: 'btn btn-warning'
      = form_with url: admin_time_path, method: :patch, class: 'd-flex flex-wrap align-items-center gap-2',
        data: { controller: 'device-time' } do |f|
        %span
          = _('Time on the Photobox:')
          %b= l(Time.now.getlocal, format: :long)
        = f.hidden_field :time, data: { device_time_target: 'input' }
        %button.btn.btn-primary{ type: 'button', data: { action: 'device-time#use' } }
          = _('Set to')
          %span{ data: { device_time_target: 'label' } }= _('the time of this device')
      .d-flex.flex-wrap.gap-2.mt-3{ data: { controller: 'modal' } }
        %button.btn.btn-warning{ type: 'button', data: { action: 'modal#open' } }= _('Change admin password')
        -# no padding on the dialog: a tap on it counts as a tap on the backdrop
        %dialog.admin-popover.p-0{ data: { modal_target: 'dialog', action: 'click->modal#closeOnBackdrop' } }
          = form_with url: admin_password_path, method: :patch, class: 'd-grid gap-2 p-4' do |f|
            = f.password_field :old_password, placeholder: _('Old password'), required: true, class: 'form-control'
            = f.password_field :new_password, placeholder: _('New password'), required: true, minlength: 8, class: 'form-control'
            = f.password_field :password_repeat, placeholder: _('Repeat new password'), required: true, class: 'form-control'
            = f.submit _('Change password'), class: 'btn btn-primary'
        = button_to _('Restart'), admin_restart_path, class: 'btn btn-warning',
          form: { data: { turbo_confirm: _('Restart the Photobox?') } }
