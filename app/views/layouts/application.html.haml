!!!
%html
  %head
    %title Photobooth
    %meta{ content: 'width=device-width, initial-scale=1.0, user-scalable=no', name: 'viewport' }
    = favicon_link_tag '/favicon.ico'
    = stylesheet_link_tag 'bootstrap-3.3.6/bootstrap.min', 'photobooth'
    = javascript_importmap_tags
    = csrf_meta_tags
    = yield(:head)

  %body
    - flash.each do |type, msg|
      .alert{ class: type == 'notice' ? 'alert-success' : 'alert-danger', role: 'alert' }= msg

    = yield
