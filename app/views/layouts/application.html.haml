!!!
%html{ lang: I18n.locale }
  %head
    %title Photobooth
    %meta{ content: 'width=device-width, initial-scale=1.0, user-scalable=no', name: 'viewport' }
    = favicon_link_tag '/favicon.ico'
    %link{ rel: 'manifest', href: pwa_manifest_path(format: :json) }
    %link{ rel: 'apple-touch-icon', href: '/icon.png' }
    %meta{ name: 'apple-mobile-web-app-capable', content: 'yes' }
    %meta{ name: 'mobile-web-app-capable', content: 'yes' }
    %meta{ name: 'apple-mobile-web-app-status-bar-style', content: 'black' }
    = stylesheet_link_tag 'bootstrap-5.3.8/bootstrap.min', 'photobooth'
    -# polyfills import maps for Firefox < 108 (Nexus 7 kiosk), modern browsers skip it
    %script{ async: true, src: asset_path('es-module-shims.min.js') }
    = javascript_importmap_tags
    = csrf_meta_tags
    = yield(:head)

  %body{ class: ('kiosk' if kiosk?) }
    - if flash.any?
      .position-fixed.top-0.start-50.translate-middle-x.mt-3.d-flex.flex-column.align-items-center.gap-2{ style: 'z-index: 1080; max-width: 90vw;' }
        - flash.each do |type, msg|
          .flash.alert.rounded-pill.shadow.px-4.py-2.m-0{ class: type == 'notice' ? 'alert-success' : 'alert-danger', role: 'alert' }= msg

    = yield
